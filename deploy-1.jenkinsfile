pipeline {
  agent any

  environment {
    NETLIFY_SITE_ID    = 'a2dc4a84-fce7-45d1-99e8-5235324b55fc'
    NETLIFY_AUTH_TOKEN = credentials('netlify-token')
  }

  stages {

    stage('Build') {
      steps {
        script {
          docker.image('node:18').inside {
            sh '''
              set -eux
              npm config set registry https://registry.npmmirror.com
              npm config set loglevel warn
              npm config set fund false
              npm config set audit false

              echo "Node and npm versions:"
              node --version
              npm --version

              if [ -f package-lock.json ]; then
                echo "Installing dependencies using npm ci"
                npm ci
              else
                echo "No package-lock.json — using npm install"
                npm install
              fi

              echo "Building project"
              npm run build

              echo "Build output:"
              [ -d build ] && ls -la build || true
              [ -d dist ]  && ls -la dist  || true
            '''
          }
        }
      }
    }

    stage('Deploy') {
      steps {
        script {
          docker.image('node:18').inside {
            sh '''
              set -eux
              npm config set loglevel warn
              npm config set fund false
              npm config set audit false

              npm install netlify-cli
              npx netlify --version

              DEPLOY_DIR="build"; [ -d dist ] && DEPLOY_DIR="dist"
              echo "Deploying to production. Site ID: $NETLIFY_SITE_ID  Dir: $DEPLOY_DIR"
              npx netlify status
              npx netlify deploy --dir="$DEPLOY_DIR" --prod
            '''
          }
        }
      }
    }

    // Optional quick diagnostics:
    // stage('Diag') { steps { sh 'set -x; node -v || true; npm -v || true; ls -la; printenv | sort | egrep "^(HTTP|HTTPS|NO_)?PROXY|NETLIFY|DOCKER_" || true' } }

  }
}
